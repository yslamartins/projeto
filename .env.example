# =============================================================================
# Projeto: Shopee Opportunity Finder
# Copie este arquivo para `.env` e ajuste conforme necessário.
#
#   Windows (PowerShell):
#     Copy-Item .env.example .env
#
#   Linux/macOS:
#     cp .env.example .env
#
# O Next.js carrega `.env` automaticamente (NAO precisa de dotenv manual).
# `node_modules/.env*`, credenciais e o próprio `.env` sao ignorados pelo git.
# =============================================================================

# -----------------------------------------------------------------------------
# TIKDROP (download de videos do TikTok)
# -----------------------------------------------------------------------------
# URL base da API TikDrop usada para resolver/baixar videos do TikTok.
# Dica: o plano free do Render pode "dormir" (cold start) — se quiser apontar
# para outra instancia, mude apenas aqui, sem tocar no codigo.
# Lido em: src/lib/tikdrop/client.ts (default: https://tikdrop-k8re.onrender.com)
TIKDROP_API_URL=https://tikdrop-k8re.onrender.com

# -----------------------------------------------------------------------------
# WHATSAPP
# -----------------------------------------------------------------------------
# Controla se o WhatsApp Web (whatsapp-web.js / Puppeteer) abre em modo
# oculto (headless) ou com navegador visivel.
#   - Qualquer valor diferente de "false"  => headless (oculto)
#   - "false" (sem aspas, minusculo)         => navegador visivel
# Lido em: src/lib/whatsapp/client.ts
WHATSAPP_HEADLESS=true

# -----------------------------------------------------------------------------
# SHOPEE (scanner)
# -----------------------------------------------------------------------------
# Caminho completo para o chrome.exe usado pelo scanner da Shopee.
# Se vazio/nao definido, o scanner procura nos locais padrao:
#   - "C:\Program Files\Google\Chrome\Application\chrome.exe"
#   - "C:\Program Files (x86)\Google\Chrome\Application\chrome.exe"
#   - %LOCALAPPDATA%\Google\Chrome\Application\chrome.exe
# Se o Chrome estiver em outro diretorio, defina aqui. SHOPEE_CHROME_PATH tem
# prioridade sobre CHROME_PATH.
# Lido em: src/lib/scanner/chrome-launcher.ts
SHOPEE_CHROME_PATH=

# -----------------------------------------------------------------------------
# GERAIS
# -----------------------------------------------------------------------------
# Ambiente de execucao. NAO defina aqui — quem controla e quem roda o app
# (npm run dev => development; npm run build/start + NODE_ENV appropriado =>
# production). Listado apenas como referencia.
# NODE_ENV=development