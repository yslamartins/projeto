datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String   @id
  title       String
  price       String
  salesCount  Int
  imageUrl    String
  productUrl  String
  searchTerm  String
  status      String   @default("pending") // pending | published | discarded
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
